{
  "name": "entry",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "wrangler types && react-router typegen && tsc -b",
    "deploy": "bun run build && wrangler deploy",
    "preview": "bun run build && vite preview",
    "migrate-local-db": "wrangler d1 migrations apply entry-db --local",
    "init-local-db": "wrangler d1 execute entry-db --local --file scripts/data-init.sql"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.1",
    "@dnd-kit/react": "^0.5.1",
    "cn": "^0.3.0",
    "isbot": "^5.1.36",
    "lucide-react": "^1.45.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cloudflare/vite-plugin": "^1.54.6",
    "@react-router/dev": "^8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.130.0"
  }
}